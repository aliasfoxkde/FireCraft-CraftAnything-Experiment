.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------------------------
# Secrets / local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!*.pub
secrets.toml
config.local.toml

# ---------------------------------------------------------------------------
# One-off scratch and build-automation scripts (kept on disk, not versioned)
# ---------------------------------------------------------------------------
# These were 400+ tracked throwaway .py/.ps1 files that the builder used to
# patch the Rust sources in place. They are scaffolding, not product code.
/app/scratch/
/app/shots/
/app/build.log
*.py1
*.bak

# ---------------------------------------------------------------------------
# Craft Anything runtime state
# ---------------------------------------------------------------------------
# These are rewritten on every agent turn: ~2 MB of diff per run, and they
# describe the run rather than the project. The durable audit trail lives in
# investigation.cany/ and checks/.
/build-activity.log
/build-activity.log.*
/craft.json
/feed.json
/transcript.json
/usage.json
/capture/window.png
/pinned/play.log
/inbox/build-progress.json
*.session.jsonl
agent-session.jsonl
